# Vorlage für die .env im selben Ordner wie docker-compose.yml.
# Kopieren:   cp .env.example .env && chmod 600 .env
# Die .env niemals ins Git-Repository übernehmen (steht in .gitignore).

# Admin-Passwort für /admin. Überschreibt manual_events.admin_password aus der config.json.
ADMIN_PASSWORD=

# Bot-Token aus dem Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=

# ID des Discord-Servers, in dem der Bot mitliest.
DISCORD_GUILD_ID=

# ID(s) der Kanäle mit den Infografiken (bei gefolgten Ankündigungskanälen
# der Zielkanal im eigenen Server).
# Mehrere IDs mit Komma trennen.
DISCORD_CHANNEL_IDS=

# Optional, empfohlen: nur Nachrichten dieser Autoren verarbeiten.
# Beim Folgen eines Ankündigungskanals ist das die ID des Follow-Webhooks
# (siehe README, Abschnitt „IDs ermitteln und eintragen“). Leer = alle Nachrichten im Kanal.
DISCORD_ALLOWED_AUTHOR_IDS=
